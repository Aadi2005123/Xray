# Backend Environment Variables Example
# Copy this file to .env and adjust values as needed.

# Server configuration
HOST=0.0.0.0
PORT=8000

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ML Inference Configuration
# Modes: "demo" (pixel-statistics simulator) or "real" (PyTorch DenseNet-121)
MODEL_MODE=demo
MODEL_INPUT_SIZE=224
# Path to PyTorch model weights when MODEL_MODE=real (e.g., models/weights/densenet121_cxr.pt)
MODEL_PATH=models/weights/densenet121_cxr.pt
MODEL_WEIGHTS_DIR=models/weights

# Upload limit in bytes (10MB default)
MAX_UPLOAD_BYTES=10485760
